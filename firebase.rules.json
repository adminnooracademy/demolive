{
  "rules": {
    "pmbRooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "participants": {
          ".indexOn": ["username", "status", "lastSeenMs", "cameraOn"]
        },
        "results": {
          ".indexOn": ["username", "submittedAt", "examKey", "score"]
        }
      }
    }
  }
}
